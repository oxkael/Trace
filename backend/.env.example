# Trace Environment Configuration Example
ENV=development
APP_NAME=Trace Engine
ALLOWED_ORIGINS=*

# Order Execution Controls (Demo Mode by default)
ORDERS_AVAILABLE=true
ORDER_MODE=demo
ORDERS_ENABLED=true
MAX_ORDER_USD=50.0
CONFIRMATION_TTL_SEC=120
PREVIEW_STALE_PCT=0.5

# Language Model Configuration (Google AI Studio / Gemini)
LLM_MODE=auto
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your_gemini_api_key_here
